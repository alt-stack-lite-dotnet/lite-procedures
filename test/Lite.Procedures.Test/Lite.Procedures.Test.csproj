<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\sources\Lite.Procedures\Lite.Procedures.csproj" />
      <ProjectReference Include="..\..\sources\Lite.Procedures.DotNet\Lite.Procedures.DotNet.csproj" />
      <ProjectReference Include="..\..\sources\Lite.Procedures.DependencyInjection\Lite.Procedures.DependencyInjection.csproj" />
      <ProjectReference Include="..\..\sources\Lite.Procedures.Pipeline.SourceGenerators\Lite.Procedures.Pipeline.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      <!-- Same generator project, referenced a second time as a PLAIN assembly (not an analyzer)
           so test code can drive it directly via CSharpGeneratorDriver. The analyzer reference
           above contributes no metadata reference (ReferenceOutputAssembly=false), so there's no clash. -->
      <ProjectReference Include="..\..\sources\Lite.Procedures.Pipeline.SourceGenerators\Lite.Procedures.Pipeline.SourceGenerators.csproj" OutputItemType="" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>